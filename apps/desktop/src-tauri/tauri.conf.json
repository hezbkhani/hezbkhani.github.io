{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nooran",
  "version": "1.0.0",
  "identifier": "io.github.hezbkhani.app",
  "build": {
    "frontendDist": "https://hezbkhani.github.io/?app=desktop"
  },
  "app": {
    "windows": [
      {
        "title": "نوران",
        "url": "https://hezbkhani.github.io/?app=desktop",
        "width": 820,
        "height": 900,
        "minWidth": 360,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "category": "Education",
    "shortDescription": "نوران",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "10.15" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
